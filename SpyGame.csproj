<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- پلتفرم‌ها -->
    <TargetFrameworks>net9.0-ios;net9.0-maccatalyst;net9.0-android35.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>SpyGame</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- نام اپ -->
    <ApplicationTitle>بازی جاسوس</ApplicationTitle>

    <!-- شناسه‌ی بسته (Android Package Name) -->
    <ApplicationId>ir.eliassarband.spygame</ApplicationId>

    <!-- نسخه‌ها -->
    <!-- DisplayVersion ~ VersionName (مثلاً 1.0.3) -->
    <ApplicationDisplayVersion>1.0.4</ApplicationDisplayVersion>
    <!-- VersionCode (عددی و افزایشی — هر بار آپدیت باید افزایش یابد) -->
    <ApplicationVersion>5</ApplicationVersion>

    <!-- حداقل پلتفرم‌های پشتیبانی‌شده -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>

    <!-- برای اندروید: API 21 ~ Android 5.0 (سازگاری با گوشی‌های قدیمی‌تر) -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- تنظیمات ویژه‌ی Release اندروید -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!--
      فرمت:
      - apk  → مستقیم برای بازار / مایکت / توزیع مستقیم
      - aab  → Google Play Store
      برای بازار و مایکت: apk را انتخاب کن
    -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- بهینه‌های Release -->
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidLinkTool>r8</AndroidLinkTool>

    <!--
      معماری‌ها:
      - armeabi-v7a  → گوشی‌های قدیمی ۳۲-بیت (Android 5+)
      - arm64-v8a    → گوشی‌های جدید ۶۴-بیت
      - x86;x86_64   → شبیه‌ساز (فقط برای Debug — در Release حذف)
    -->
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>

    <!--
      برای امضای APK جهت انتشار در بازار/مایکت:
      ۱. یه keystore بساز: keytool -genkey -v -keystore spy-release.keystore -alias spykey -keyalg RSA -keysize 2048 -validity 10000
      ۲. فایل keystore رو کنار csproj بذار
      ۳. خطوط زیر را آنکامنت و پر کن
    -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>spy-release.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>spykey</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>Spy@2026</AndroidSigningKeyPass>
    <AndroidSigningStorePass>Spy@2026</AndroidSigningStorePass>
  </PropertyGroup>

  <!-- نسخه‌بندی: هر بار قبل از انتشار افزایش بده -->
  <!--
    ApplicationDisplayVersion = نسخه نمایشی (مثلاً 1.2.0)
    ApplicationVersion         = VersionCode عددی — باید همیشه افزایشی باشه
    مثال ارسال:
      v1.1.0 → ApplicationVersion=2
      v1.2.0 → ApplicationVersion=3
  -->

  <!-- آیکن -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Splash -->
    <MauiSplashScreen Include="Resources\Splash\logo.png" Color="#121212" BaseSize="256,256" />

    <!-- تصاویر -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

    <!-- فونت‌ها -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- دارایی‌های خام (صوت و …) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="Plugin.Maui.Audio" Version="3.1.1" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views\RevealPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SetupPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SplashPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\TimerPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\ResultPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\TutorialPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\StatisticsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\CustomWordsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\UpgradePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <!-- اختیاری: فقط برای Windows اگر آیکن پنجره می‌خواهی -->
  <!--
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <ApplicationIcon>Platforms\Windows\appicon.ico</ApplicationIcon>
  </PropertyGroup>
  -->

</Project>
