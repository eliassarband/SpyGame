<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpyGame.Views.SetupPage"
             Title="تنظیمات بازی"
             FlowDirection="RightToLeft">

    <ScrollView>
        <Border x:Name="Card" Style="{StaticResource Card}" Margin="12">
            <VerticalStackLayout Spacing="14" Padding="8">

                <!-- عنوان + آیکن تم -->
                <Grid ColumnDefinitions="44,*,44">
                    <Button Grid.Column="0" x:Name="ThemeButton"
                            Text="☀️" FontSize="20"
                            BackgroundColor="Transparent"
                            BorderWidth="0" Padding="0"
                            WidthRequest="44" HeightRequest="44"
                            Clicked="OnThemeToggle"/>
                    <Label Grid.Column="1"
                           Text="تنظیمات بازی"
                           Style="{StaticResource TitleLarge}"
                           HorizontalOptions="Center"/>
                </Grid>

                <!-- دسته‌بندی -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="دسته‌بندی" Style="{StaticResource BodyDim}"
                           VerticalTextAlignment="Center"/>
                    <Picker Grid.Column="1" x:Name="CategoryPicker"
                            ItemDisplayBinding="{Binding DisplayName}"/>
                </Grid>

                <!-- درجه سختی -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="درجه سختی" Style="{StaticResource BodyDim}"
                           VerticalTextAlignment="Center"/>
                    <Picker Grid.Column="1" x:Name="DifficultyPicker"/>
                </Grid>

                <!-- تعداد کلمات -->
                <Label x:Name="WordCountLabel"
                       Text="کلمات: کل 0 / قابل انتخاب 0"
                       Style="{StaticResource BodyDim}"
                       HorizontalOptions="Center"/>

                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>

                <!-- تعداد بازیکن -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="تعداد بازیکن" Style="{StaticResource BodyDim}"
                           VerticalTextAlignment="Center"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Button Text="−" WidthRequest="44" HeightRequest="44"
                                CornerRadius="8" Padding="0" FontSize="22"
                                BackgroundColor="{AppThemeBinding Light=#DEDEDE, Dark=#444444}"
                                TextColor="{AppThemeBinding Light=#212121, Dark=#ffffff}"
                                Clicked="OnPlayersMinus"/>
                        <Label x:Name="PlayersLabel" Text="6"
                               FontSize="20" FontAttributes="Bold"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center"
                               WidthRequest="40"/>
                        <Button Text="+" WidthRequest="44" HeightRequest="44"
                                CornerRadius="8" Padding="0" FontSize="22"
                                BackgroundColor="{AppThemeBinding Light=#DEDEDE, Dark=#444444}"
                                TextColor="{AppThemeBinding Light=#212121, Dark=#ffffff}"
                                Clicked="OnPlayersPlus"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- تعداد جاسوس -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="تعداد جاسوس" Style="{StaticResource BodyDim}"
                           VerticalTextAlignment="Center"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Button Text="−" WidthRequest="44" HeightRequest="44"
                                CornerRadius="8" Padding="0" FontSize="22"
                                BackgroundColor="{AppThemeBinding Light=#DEDEDE, Dark=#444444}"
                                TextColor="{AppThemeBinding Light=#212121, Dark=#ffffff}"
                                Clicked="OnSpiesMinus"/>
                        <Label x:Name="SpiesLabel" Text="2"
                               FontSize="20" FontAttributes="Bold"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center"
                               WidthRequest="40"/>
                        <Button Text="+" WidthRequest="44" HeightRequest="44"
                                CornerRadius="8" Padding="0" FontSize="22"
                                BackgroundColor="{AppThemeBinding Light=#DEDEDE, Dark=#444444}"
                                TextColor="{AppThemeBinding Light=#212121, Dark=#ffffff}"
                                Clicked="OnSpiesPlus"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- زمان -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="زمان (دقیقه)" Style="{StaticResource BodyDim}"
                           VerticalTextAlignment="Center"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Button Text="−" WidthRequest="44" HeightRequest="44"
                                CornerRadius="8" Padding="0" FontSize="22"
                                BackgroundColor="{AppThemeBinding Light=#DEDEDE, Dark=#444444}"
                                TextColor="{AppThemeBinding Light=#212121, Dark=#ffffff}"
                                Clicked="OnMinutesMinus"/>
                        <Label x:Name="MinutesLabel" Text="3"
                               FontSize="20" FontAttributes="Bold"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center"
                               WidthRequest="40"/>
                        <Button Text="+" WidthRequest="44" HeightRequest="44"
                                CornerRadius="8" Padding="0" FontSize="22"
                                BackgroundColor="{AppThemeBinding Light=#DEDEDE, Dark=#444444}"
                                TextColor="{AppThemeBinding Light=#212121, Dark=#ffffff}"
                                Clicked="OnMinutesPlus"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- جاسوس‌ها هم‌دیگه رو بشناسن -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="جاسوس‌ها هم‌دیگه رو بشناسن" Style="{StaticResource BodyDim}"
                           VerticalTextAlignment="Center"/>
                    <Switch Grid.Column="1" x:Name="SpiesKnowSwitch"
                            IsToggled="False" HorizontalOptions="Start"/>
                </Grid>

                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>

                <!-- شروع بازی -->
                <Button Text="شروع بازی"
                        Style="{StaticResource SetupPrimaryButton}"
                        FontSize="17"
                        Clicked="OnStartClicked"
                        Margin="0,4"/>

                <!-- ردیف اول ناوبری -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="آموزش" FontSize="13"
                            Style="{StaticResource TimerSecondaryButton}"
                            Clicked="OnTutorialClicked" Padding="4,10"/>
                    <Button Grid.Column="1" Text="آمار" FontSize="13"
                            Style="{StaticResource TimerSecondaryButton}"
                            Clicked="OnStatisticsClicked" Padding="4,10"/>
                    <Button Grid.Column="2" Text="کلمات من" FontSize="13"
                            Style="{StaticResource TimerSecondaryButton}"
                            Clicked="OnCustomWordsClicked" Padding="4,10"/>
                </Grid>

                <!-- دکمه ارتقاء ویژه -->
                <Button x:Name="UpgradeNavButton"
                        Text="ارتقاء به ویژه 🌟"
                        FontSize="14"
                        BackgroundColor="#512BD4" TextColor="White" CornerRadius="8"
                        Clicked="OnUpgradeClicked" Padding="8,10"/>

                <!-- تاریخچه -->
                <Button Text="تاریخچه ۵۰۰ کلمه آخر"
                        Style="{StaticResource TimerSecondaryButton}"
                        FontSize="13"
                        Clicked="OnShowHistoryClicked"
                        Margin="0,0,0,4"/>

            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
