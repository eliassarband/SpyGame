<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpyGame.Views.TimerPage"
             Title="تایمر بازی"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}">

    <!-- مخفی کردن فلش Back -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid>
        <!-- کارت کمی عریض‌تر و دکمه‌ها پایین کارت -->
        <Border x:Name="Card"
                Style="{StaticResource Card}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MinimumWidthRequest="340"
                MaximumWidthRequest="760">
            <Border.WidthRequest>
                <OnIdiom x:TypeArguments="x:Double">
                    <OnIdiom.Phone>390</OnIdiom.Phone>
                    <OnIdiom.Tablet>580</OnIdiom.Tablet>
                </OnIdiom>
            </Border.WidthRequest>

            <Grid RowSpacing="12" Padding="8,8,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- info -->
                    <RowDefinition Height="Auto"/>
                    <!-- timer -->
                    <RowDefinition Height="Auto"/>
                    <!-- warning -->
                    <RowDefinition Height="Auto"/>
                    <!-- hint -->
                    <RowDefinition Height="*"/>
                    <!-- spacer: push controls to bottom -->
                    <RowDefinition Height="Auto"/>
                    <!-- start/pause -->
                    <RowDefinition Height="Auto"/>
                    <!-- reset/finish -->
                </Grid.RowDefinitions>

                <!-- اطلاعات بازی -->
                <HorizontalStackLayout Grid.Row="0" Spacing="16" HorizontalOptions="Center">
                    <Label x:Name="PlayersInfoLabel"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
                    <Label x:Name="SpiesInfoLabel"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
                </HorizontalStackLayout>

                <!-- تایمر -->
                <Label x:Name="TimerLabel"
                       Grid.Row="1"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold"
                       LineBreakMode="NoWrap"
                       Margin="0,4,0,0">
                    <Label.FontSize>
                        <OnIdiom x:TypeArguments="x:Double">
                            <OnIdiom.Phone>56</OnIdiom.Phone>
                            <OnIdiom.Tablet>84</OnIdiom.Tablet>
                        </OnIdiom>
                    </Label.FontSize>
                </Label>

                <!-- هشدار -->
                <Label x:Name="WarningLabel"
                       Grid.Row="2"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}">
                    <Label.FontSize>
                        <OnIdiom x:TypeArguments="x:Double">
                            <OnIdiom.Phone>20</OnIdiom.Phone>
                            <OnIdiom.Tablet>24</OnIdiom.Tablet>
                        </OnIdiom>
                    </Label.FontSize>
                </Label>

                <!-- توضیح/راهنما -->
                <Label x:Name="WordHintLabel"
                       Grid.Row="3"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       FontSize="14" />

                <!-- spacer (ردیف 4) -->

                <!-- کنترل‌ها: پایین کارت -->
                <HorizontalStackLayout Grid.Row="5" Spacing="12" HorizontalOptions="Center">
                    <Button Text="شروع / مکث"
                            Style="{StaticResource TimerPrimaryButton}"
                            FontSize="Medium"
                            Clicked="OnStartPause"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Row="6" Spacing="12" HorizontalOptions="Center" Margin="0,0,0,2">
                    <Button Text="ریست" Style="{StaticResource TimerSecondaryButton}" Clicked="OnReset"/>
                    <Button Text="اتمام بازی" Style="{StaticResource TimerDangerButton}" Clicked="OnFinish"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
