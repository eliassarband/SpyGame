<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpyGame.Views.RevealPage"
             Title="نمایش به بازیکن"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid>
        <!-- کارت با عرض و ارتفاع ثابت‌تر برای هر دو رو -->
        <Border x:Name="Card"
                Style="{StaticResource Card}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MinimumWidthRequest="340"
                MaximumWidthRequest="760"
                >
            <Border.WidthRequest>
                <OnIdiom x:TypeArguments="x:Double">
                    <OnIdiom.Phone>380</OnIdiom.Phone>
                    <OnIdiom.Tablet>560</OnIdiom.Tablet>
                </OnIdiom>
            </Border.WidthRequest>
            <Border.MinimumHeightRequest>
                <OnIdiom x:TypeArguments="x:Double">
                    <!-- کمی بلندتر تا تغییر متن، ارتفاع کارت را تکان ندهد -->
                    <OnIdiom.Phone>460</OnIdiom.Phone>
                    <OnIdiom.Tablet>560</OnIdiom.Tablet>
                </OnIdiom>
            </Border.MinimumHeightRequest>

            <!-- دو رو: Front / Back روی هم قرار می‌گیرند -->
            <Grid>
                <!-- رویِ کارت (Front) -->
                <Grid x:Name="FrontSide"
                      RowSpacing="12" Padding="8,8,8,12" IsVisible="True"
                      InputTransparent="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- header -->
                        <RowDefinition Height="*"/>
                        <!-- content (placeholder) -->
                        <RowDefinition Height="Auto"/>
                        <!-- hint -->
                        <RowDefinition Height="Auto"/>
                        <!-- main button -->
                        <RowDefinition Height="Auto"/>
                        <!-- back to setup -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Label x:Name="PlayerIndexLabelFront"
                           Grid.Row="0"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                           Margin="0,0,0,4"/>

                    <!-- Placeholder برای ثابت ماندن ارتفاع ناحیهٔ محتوا -->
                    <Grid Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- ارتفاع رزرو: معادل دو خط بزرگ -->
                        <Label Text="نمونه نمونه&#x0a;نمونه نمونه"
                               FontSize="36"
                               FontAttributes="Bold"
                               Opacity="0"
                               IsEnabled="False"
                               InputTransparent="True"
                               HorizontalTextAlignment="Center" />
                    </Grid>

                    <!-- Hint -->
                    <Label Grid.Row="2"
                           Text="برای دیدن نقش/کلمه، دکمه را بزن."
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           Margin="0,0,0,2"/>

                    <!-- Action -->
                    <Button x:Name="FrontRevealButton"
                            Grid.Row="3"
                            Text="نمایش"
                            Style="{StaticResource CircularRevealButton}"
                            FontSize="Medium"
                            Clicked="OnRevealClicked"
                            HorizontalOptions="Center"
                            Margin="0,6,0,4"/>

                    <!-- Back to setup -->
                    <Button Grid.Row="4"
                            Text="بازگشت به Setup"
                            Clicked="OnBackToSetup"
                            HorizontalOptions="Center"
                            Style="{StaticResource TimerSecondaryButton}"
                            Padding="12,8"
                            Margin="0,0,0,2"/>
                </Grid>

                <!-- پشتِ کارت (Back) -->
                <Grid x:Name="BackSide"
                      RowSpacing="12" Padding="8,8,8,12" IsVisible="False"
                      InputTransparent="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- header -->
                        <RowDefinition Height="*"/>
                        <!-- content -->
                        <RowDefinition Height="Auto"/>
                        <!-- hint -->
                        <RowDefinition Height="Auto"/>
                        <!-- main button -->
                        <RowDefinition Height="Auto"/>
                        <!-- back to setup -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Label x:Name="PlayerIndexLabelBack"
                           Grid.Row="0"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                           Margin="0,0,0,4"/>

                    <!-- محتوای مرکزی: دو حالت -->
                    <!-- محتوای مرکزی -->
                    <Grid Grid.Row="1"
                          HorizontalOptions="FillAndExpand"
                          VerticalOptions="Center">

                        <!-- رزرو ارتفاع (هم‌عرض شود) -->
                        <Label Text="نمونه نمونه&#x0a;نمونه نمونه"
                               FontSize="36"
                               FontAttributes="Bold"
                               Opacity="0"
                               IsEnabled="False"
                               InputTransparent="True"
                               HorizontalOptions="FillAndExpand"
                               HorizontalTextAlignment="Center" />

                        <!-- حالت کلمه -->
                        <VerticalStackLayout x:Name="WordStack"
                                             Spacing="8"
                                             HorizontalOptions="FillAndExpand"
                                             VerticalOptions="Center"
                                             IsVisible="False">

                            <Label x:Name="WordPrefixLabel"
                                   Text="کلمه:"
                                   FontSize="20"
                                   HorizontalOptions="FillAndExpand"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>

                            <Label x:Name="WordValueLabel"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   LineBreakMode="NoWrap"
                                   MaxLines="1"
                                   HorizontalOptions="FillAndExpand"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"/>
                        </VerticalStackLayout>

                        <!-- حالت جاسوس -->
                        <VerticalStackLayout x:Name="SpyStack" IsVisible="False" Spacing="6" HorizontalOptions="FillAndExpand">
                            <Label x:Name="SpyLabel"
                                   Text=""
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   HorizontalOptions="FillAndExpand"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"/>
                            <Label x:Name="SpyPartnersLabel"
                                   Text=""
                                   FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   IsVisible="False"/>
                        </VerticalStackLayout>
                    </Grid>


                    <!-- Hint -->
                    <Label Grid.Row="2"
                           Text="برای تحویل به نفر بعد، دکمه را بزن."
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           Margin="0,0,0,2"/>

                    <!-- Action -->
                    <Button x:Name="BackRevealButton"
                            Grid.Row="3"
                            Text="گوشی را بده نفر بعد"
                            Style="{StaticResource CircularRevealButton}"
                            FontSize="Medium"
                            Clicked="OnRevealClicked"
                            HorizontalOptions="Center"
                            Margin="0,6,0,4"/>

                    <!-- Back to setup -->
                    <Button Grid.Row="4"
                            Text="بازگشت به Setup"
                            Clicked="OnBackToSetup"
                            HorizontalOptions="Center"
                            Style="{StaticResource TimerSecondaryButton}"
                            Padding="12,8"
                            Margin="0,0,0,2"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
